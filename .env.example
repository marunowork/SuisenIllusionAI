# SuisenGalleryAPI Lite - 環境変数サンプル
# 実際の値を設定した .env を作成し、Gitへは登録しないこと。

APP_ENV=production
APP_NAME=SuisenGalleryAPI Lite
LOG_LEVEL=INFO

# --- Google Gemini API ---
GOOGLE_API_KEY=xxxxxxxx
# 画像生成に対応したGeminiモデルIDをGoogle公式仕様で確認のうえ設定する
GEMINI_IMAGE_MODEL=xxxxxxxx

# --- Firebase ---
FIREBASE_PROJECT_ID=xxxxxxxx
FIREBASE_STORAGE_BUCKET=xxxxxxxx
FIREBASE_SERVICE_ACCOUNT_PATH=/app/firebase/service-account.json
# true: 画像を公開URLにする / false: Signed URL(短時間有効URL)を発行する
FIREBASE_PUBLIC_URL=true
SIGNED_URL_EXPIRE_MINUTES=60

# --- 画像処理 ---
IMAGE_TEMP_DIR=/data/images
MAX_IMAGE_SIZE_MB=20
API_TIMEOUT_SECONDS=300
TEMP_FILE_MAX_AGE_HOURS=24

# --- Rate Limit ---
RATE_LIMIT_PER_MINUTE=5

# --- ページネーション ---
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
